# --- App ---------------------------------------------------------------
# Public URL Checkout redirects back to and the server binds behind.
APP_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# --- MySQL ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=thelocaldesk
DB_PASSWORD=
DB_NAME=thelocaldesk

# --- Stripe (sandbox — AIC Ecommerce PTY Ltd) -----------------------------
# https://dashboard.stripe.com/test/apikeys — never commit the real value
STRIPE_SECRET_KEY=sk_test_...

# Set after registering the webhook endpoint (Stripe CLI locally, or
# Dashboard > Developers > Webhooks for the deployed URL)
STRIPE_WEBHOOK_SECRET=whsec_...

# Products, prices, descriptions, images, and category (Product metadata
# `category`: full_time | flexible | daily) are all managed directly in the
# Stripe Dashboard — see src/lib/products.ts. No price IDs need setting here.

# --- Brevo (transactional email — purchase confirmations only) -----------
# Dashboard > Settings > SMTP & API > API Keys. Separate from the newsletter
# subscribe form, which posts straight to Brevo and needs no key. The
# "Get in touch" contact form uses GoDaddy's own email gateway instead (no
# key needed) — see src/lib/emailGateway.ts.
BREVO_API_KEY=xkeysib-...

# --- Contact form recipient ------------------------------------------------
# Where "Get in touch" submissions are emailed via GoDaddy's native email
# gateway (src/lib/emailGateway.ts) — read from env per the platform's own
# contract rather than hardcoded, so it can change without a redeploy.
CONTACT_FORM_RECIPIENT_EMAIL=ally@thelocaldesk.au

# --- Account magic links ("Manage membership") ----------------------------
# Signs the passwordless magic-link token (src/lib/magicLink.ts) used by
# /account to reach a Stripe Billing Portal session — generate a random
# value (e.g. `openssl rand -hex 32`) and never reuse across environments.
ACCOUNT_LINK_SECRET=...
