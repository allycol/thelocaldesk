# --- App ---------------------------------------------------------------
# Public URL Checkout redirects back to and the server binds behind.
APP_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# --- MySQL ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=thelocaldesk
DB_PASSWORD=
DB_NAME=thelocaldesk

# --- Stripe (sandbox — AIC Ecommerce PTY Ltd) -----------------------------
# https://dashboard.stripe.com/test/apikeys — never commit the real value
STRIPE_SECRET_KEY=sk_test_...

# Set after registering the webhook endpoint (Stripe CLI locally, or
# Dashboard > Developers > Webhooks for the deployed URL)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional overrides for the sandbox Price IDs baked into src/lib/plans.ts —
# set these when you swap in live-mode Price IDs.
# STRIPE_PRICE_HOT_DESK=
# STRIPE_PRICE_DEDICATED_DESK=
# STRIPE_PRICE_PRIVATE_OFFICE=
# STRIPE_PRICE_DAY_PASS=
# STRIPE_PRICE_MEETING_ROOM=
